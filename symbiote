#!/bin/sh
set -eu
case " ${NODE_OPTIONS:-} " in
  *' --experimental-strip-types '*) ;;
  *) NODE_OPTIONS="${NODE_OPTIONS:-} --experimental-strip-types"; export NODE_OPTIONS ;;
esac
script=$0
if [ -L "$script" ]; then
  link=$(readlink "$script")
  case "$link" in /*) script=$link ;; *) script=$(dirname "$script")/$link ;; esac
fi
root=$(CDPATH= cd -- "$(dirname "$script")" && pwd)
portable="$(dirname "$root")/runtime/node-v22.19.0/bin/node"
if [ -x "$portable" ]; then node=$portable
elif command -v node >/dev/null 2>&1; then node=$(command -v node)
else echo 'Node.js 22.19 or newer is required. Run the Symbiote installer.' >&2; exit 1
fi
exec "$node" "$root/ai-service/launcher.ts" "$@"
