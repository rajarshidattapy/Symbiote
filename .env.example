# Paste the complete Cookie request header value on one line; keep it private.
CHATGPT_COOKIE=
# Use the User-Agent from the same browser session if needed.
CHATGPT_USER_AGENT=

# Gemini website cookie values, not the entire Cookie header.
GEMINI_SECURE_1PSID=
GEMINI_SECURE_1PSIDTS=

# Symbiote writes the selected provider automatically during onboarding.
# SYMBIOTE_PROVIDER=chatgpt
